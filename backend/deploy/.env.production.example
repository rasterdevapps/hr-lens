# HR Lens server — production settings. Copy to /opt/hrlens-server/.env and edit.
# Real environment variables override this file.

# PostgreSQL. Create a database and a strong password first (see DEPLOY.md).
DATABASE_URL=postgres://hrlens:CHANGE_ME_STRONG@localhost:5432/hrlens?sslmode=disable

# The server listens here. A reverse proxy (Caddy / Cloudflare Tunnel) terminates HTTPS and
# forwards to this address, so :8080 is right for that setup.
HTTP_ADDR=:8080

# The app is served from the same origin as the API, so the browser never makes a cross-origin
# call and CORS is not used. Set this to your public URL only if you add cross-origin clients.
CORS_ORIGIN=https://hrlens.example.com

SESSION_TTL_HOURS=12

# true in production: session cookies are only sent over HTTPS. Requires the site to be HTTPS.
COOKIE_SECURE=true

# First super admin, created on first start only while the users table is empty.
ADMIN_EMAIL=admin@example.com
# Set ADMIN_PASSWORD for the very first start, then remove this line and restart.
# ADMIN_PASSWORD=choose-a-strong-password

# Screenshots and recordings are stored here; keep it on a disk with room.
DATA_DIR=/var/lib/hrlens/data
# Captures older than this many days are deleted (0 keeps them forever).
RETENTION_DAYS=30

# Served files, relative to WorkingDirectory (/opt/hrlens-server).
EXTENSION_DIR=dist/extension
AGENT_DIR=dist/agent
# The built Angular app. Empty disables web serving (development only).
WEB_DIR=web
