# Copy to .env and adjust. Real environment variables win over this file.
DATABASE_URL=postgres://hrlens:hrlens@localhost:5432/hrlens?sslmode=disable
HTTP_ADDR=:8080

# The web app's address(es), comma-separated. Only these may call the API from a browser.
CORS_ORIGIN=http://localhost:4200,http://localhost:4201

SESSION_TTL_HOURS=12
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# First super admin, created on startup only while the users table is empty.
# The password must be 8 to 72 characters. Changing it here later has no effect:
# use  go run ./cmd/server -set-password <email>  to change an existing password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-use

# Where screenshots and screen recordings from the desktop agent are stored
DATA_DIR=data
# Delete screenshots and recordings older than this many days (0 = keep forever)
RETENTION_DAYS=30
