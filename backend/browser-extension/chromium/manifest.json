{
  "manifest_version": 3,
  "name": "HR Lens",
  "version": "1.0.0",
  "description": "Tells the HR Lens agent on this computer which website the front tab shows (the site name only).",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:47123/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "110",
  "key": ""
}
